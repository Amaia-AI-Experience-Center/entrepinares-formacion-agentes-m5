# PLANTILLA: copia este archivo a ".env" (raiz del repositorio) y rellena los valores.
# ".env" esta en .gitignore: NUNCA lo subas a Git. No contiene secretos: la
# autenticacion se hace con tu sesion de Azure CLI (az login).
# El Cuaderno 1 (offline) NO necesita nada de esto.

# Proyecto de Microsoft Foundry (portal de Foundry > tu proyecto > endpoint del proyecto)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# Nombre del DESPLIEGUE del modelo en tu proyecto
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Opcional: tenant de Microsoft Entra ID (si tu cuenta pertenece a varios)
AZURE_TENANT_ID=

# Demostracion Hosted V5 (scripts/probar_hosted_v5.py y scripts/consultar_kev_blob.py)
HOSTED_AGENT_NAME=entrepinares-itot-v5-lab
ENTREPINARES_BLOB_ACCOUNT_URL=https://<cuenta>.blob.core.windows.net